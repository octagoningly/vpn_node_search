# 复制为 .env 并填入你的密钥（.env 已被 .gitignore 忽略，不会上传）

# GitHub Personal Access Token — 用于 sources.github 代码搜索
# 权限建议：Classic → 只勾 public_repo；Fine-grained → Contents: Read + Metadata: Read
GITHUB_TOKEN=

# AbuseIPDB — IP 纯净度/信誉检测
# 免费注册: https://www.abuseipdb.com/account/api
# 返回 abuseConfidenceScore 0-100（越高越脏），项目内归一化为纯净度 0-1
ABUSEIPDB_KEY=

# IPinfo — 更准的 Geo（城市/国家）+ anycast/ASN
# 免费注册: https://ipinfo.io/signup
IPINFO_TOKEN=
